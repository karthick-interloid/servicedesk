# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already covered by .gitignore.

# --- Server-only vars ---
# Available only in Node.js (route handlers, server components). Never sent to the browser.

# Secret used to sign/encrypt session data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Error monitoring (Sentry) ---
# Optional. Leave blank to disable Sentry entirely (no-op in dev).
# Server-side DSN, used in instrumentation.ts.
SENTRY_DSN=
# Org/project slugs + auth token, used only at build time to upload source maps.
# Not needed for local dev.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Client-exposed vars ---
# Prefixed with NEXT_PUBLIC_, inlined into the JS bundle at build time.
# Never put secrets here — this value is public.

# Base URL the browser uses to call the API.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Client-side Sentry DSN (same project as SENTRY_DSN above, safe to expose).
NEXT_PUBLIC_SENTRY_DSN=

# --- SEO ---
# Canonical base URL of the deployed site (no trailing slash). Used for
# metadataBase, canonical URLs, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site name — used as the OG/Twitter site name and the "%s | <name>" title template.
NEXT_PUBLIC_SITE_NAME=Starter Template

# Default meta description, used when a page doesn't set its own.
NEXT_PUBLIC_SITE_DESCRIPTION=A production-ready Next.js starter template.

# Optional: Twitter/X handle for twitter:site card metadata, e.g. @vercel.
NEXT_PUBLIC_TWITTER_HANDLE=@Interloid

# --- Health check ---
# Optional. Protects the GET /api/health URL.
# - Leave it BLANK (recommended for local dev) so the URL is open and you can
#   open it in a browser.
# - Set it (recommended for production) to make the URL private: callers must send
#   the header "Authorization: Bearer <token>", or they get a 404. A browser can't
#   send that header, so a set token means the browser always shows 404 — expected.
# Docker sends this token automatically. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HEALTH_CHECK_TOKEN=
