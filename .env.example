# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already covered by .gitignore.

# --- Server-only vars ---
# Available only in Node.js (route handlers, server components). Never sent to the browser.

# Secret used to sign/encrypt session data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Error monitoring (Sentry) ---
# Optional. Leave blank to disable Sentry entirely (no-op in dev).
# Server-side DSN, used in instrumentation.ts.
SENTRY_DSN=
# Org/project slugs + auth token, used only at build time to upload source maps.
# Not needed for local dev.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Client-exposed vars ---
# Prefixed with NEXT_PUBLIC_, inlined into the JS bundle at build time.
# Never put secrets here — this value is public.

# Base URL the browser uses to call the API.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Client-side Sentry DSN (same project as SENTRY_DSN above, safe to expose).
NEXT_PUBLIC_SENTRY_DSN=

# --- SEO ---
# Canonical base URL of the deployed site (no trailing slash). Used for
# metadataBase, canonical URLs, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site name — used as the OG/Twitter site name and the "%s | <name>" title template.
NEXT_PUBLIC_SITE_NAME=Starter Template

# Default meta description, used when a page doesn't set its own.
NEXT_PUBLIC_SITE_DESCRIPTION=A production-ready Next.js starter template.

# Optional: Twitter/X handle for twitter:site card metadata, e.g. @vercel.
NEXT_PUBLIC_TWITTER_HANDLE=@Interloid

# --- Health check ---
# Optional. Protects the GET /api/health URL.
# - Leave it BLANK (recommended for local dev) so the URL is open and you can
#   open it in a browser.
# - Set it (recommended for production) to make the URL private: callers must send
#   the header "Authorization: Bearer <token>", or they get a 404. A browser can't
#   send that header, so a set token means the browser always shows 404 — expected.
# Docker sends this token automatically. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HEALTH_CHECK_TOKEN=

# --- Supabase ---
# Both are exposed to the browser. The anon (publishable) key is safe to publish: it grants
# nothing on its own, because every table is behind RLS. There is intentionally NO
# service-role key here — app code must never bypass RLS.
# Find them under Project Settings → API, or in the output of `supabase start` for local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS entirely. Server-only: no NEXT_PUBLIC_ prefix, never sent
# to the browser, never committed. Used solely to provision a new organization at signup,
# where the RLS policies cannot be satisfied yet (no membership exists, so no tenant_role
# claim). Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in ---
# Read by the local Supabase Auth container via supabase/config.toml's [auth.external.google]
# — NOT by the Next app, which never sees them. Put them in supabase/.env or export them
# before `supabase start`; hosted projects set the same pair under
# Authentication → Providers → Google instead.
#
# From an OAuth 2.0 "Web application" client in the Google Cloud console. Its Authorized
# redirect URI must be Supabase's callback, not ours:
#   local   http://127.0.0.1:54321/auth/v1/callback
#   hosted  https://<project-ref>.supabase.co/auth/v1/callback
#
# NEXT_PUBLIC_SITE_URL above has to match the origin you actually browse on: it is what
# builds the `${SITE_URL}/auth/callback` address Supabase returns the browser to, and that
# address must appear in config.toml's `additional_redirect_urls`.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
